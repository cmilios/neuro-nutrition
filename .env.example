# Public browser configuration. Copy to `.env.local` for local development.
VITE_SUPABASE_URL=https://cmayisxvronrwvzhyuer.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-the-project-publishable-or-anon-key

# OAuth rollout modes: off | verify | on
# Use `verify` while testing /neuro-nutrition/verify-oauth, then promote to `on`.
VITE_OAUTH_GOOGLE_MODE=off
VITE_OAUTH_APPLE_MODE=off

# Optional browser incident-delivery fallback.
VITE_CLIENT_INCIDENT_ALERT_URL=

# Optional build identifier shown in privacy-limited incident telemetry.
VITE_RELEASE_ID=development
